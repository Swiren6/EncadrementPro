@model EncadrementPro.Models.Professeur

@{
    ViewData["Title"] = "Supprimer Professeur";
}

<h2>Confirmer la suppression</h2>

<div>
    <h4>Êtes-vous sûr de vouloir supprimer ce professeur ?</h4>
    <div><strong>Nom : </strong>@Model.Nom</div>
    <div><strong>Email : </strong>@Model.Email</div>
    <div><strong>Spécialité : </strong>@Model.Specialite</div>
</div>

<form asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>
